{
  "name": "how-much-calories-left",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:jev": "vitest run --config vitest.eval.mts evalJev",
    "eval:local-router": "vitest run --config vitest.eval.mts evalLocalRouter",
    "eval:food-judgment": "vitest run --config vitest.eval.mts evalFoodJudgment",
    "eval:food-coverage": "vitest run --config vitest.eval.mts evalFoodCoverage",
    "eval:food-modifiers": "vitest run --config vitest.eval.mts evalFoodModifiers",
    "sync:mfds": "vitest run --config vitest.sync.mts",
    "candidates:mfds": "vitest run --config vitest.candidates.mts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
