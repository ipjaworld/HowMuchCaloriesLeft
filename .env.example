# ─────────────────────────────────────────────────────────────
# HowMuchCaloriesLeft — environment variables
# Copy to .env.local and fill in. Never commit real keys.
# ─────────────────────────────────────────────────────────────

# TypeSafe AI (Jev) — structured judgment.
# Optional. When empty the app falls back to a deterministic mock judge,
# so the whole project still runs without a key. Added in Phase 4.
TYPESAFE_API_KEY=

# Anthropic — LLM *fallback* parser only (food name + quantity extraction).
# Optional. Never used to generate calorie values. Added in Phase 5.
ANTHROPIC_API_KEY=

# 식품의약품안전처 식품영양성분DB — nutrition lookup data.
# Optional. Only `pnpm sync:mfds` reads it; the app itself reads the dataset
# file that script writes. Get one at https://www.data.go.kr/data/15127578/openapi.do
# (활용신청 → 개발계정 자동승인). Use the *decoded* key. Added in Phase 5B.
MFDS_FOOD_NUTRITION_API_KEY=

# Optional override; this is the default.
MFDS_FOOD_NUTRITION_ENDPOINT=https://apis.data.go.kr/1471000/FoodNtrCpntDbInfo03