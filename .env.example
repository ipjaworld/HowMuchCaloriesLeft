# ─────────────────────────────────────────────────────────────
# HowMuchCaloriesLeft — environment variables
# Copy to .env.local and fill in. Never commit real keys.
# ─────────────────────────────────────────────────────────────

# TypeSafe AI (Jev) — structured judgment.
# Optional. When empty the app falls back to a deterministic mock judge,
# so the whole project still runs without a key. Added in Phase 4.
TYPESAFE_API_KEY=

# Anthropic — LLM *fallback* parser only (food name + quantity extraction).
# Optional. Never used to generate calorie values. Added in Phase 5.
ANTHROPIC_API_KEY=
